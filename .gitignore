.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
# 运行态数据仍忽略；评测基准商品集必须随代码版本化。
data/*
!data/catalog-v1.jsonl
eval/report-*.md
# 召回评测报告同样是每次跑测的产物，不入库；标注集（eval/*.jsonl）要入库
eval/recall-report-*.md
eval/category-recall-report-*.md

# 课程资料与本地工具目录：只保留在本地，不入工程仓库
.baoyu-skills/
.idea/
.qoder/
/images/
/learn-claude-code/
/pi/
node_modules/

# Local Codex settings, package cache, and evaluation server output.
/.codex/
/.npm-cache/
/eval/verification/*-server.*.log
# 本地临时产物：pytest 临时目录与调试/采集输出，不入库
/.pytest-*/
/output/

# 课程仓库内容（根目录）：只保留在本地 main 分支，不入工程仓库
/*.md
