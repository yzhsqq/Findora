# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data
# fixture = 冻结样例目录；cj = DATA_DIR/cj_catalog.sqlite3 本地 CJ 快照
CATALOG_SOURCE=fixture
# Optional Amazon US snapshot alongside CJ (set CATALOG_SOURCE=cj).
# Import first: python scripts/import_amazon_catalog.py --input <Amazon JSON>
AMAZON_CATALOG_PATH=
# Optional eBay US snapshot alongside CJ (set CATALOG_SOURCE=cj).
# Import first: python scripts/import_ebay_catalog.py --input <eBay JSON>
EBAY_CATALOG_PATH=
# 上轮未通过留出集的 CJ 词典候选默认关闭；只供显式隔离实验。
CJ_EXPERIMENTAL_LEXICON=0

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# 单个 embedding 分片遇到断连、限流或 5xx 时的重试次数。
EMBEDDING_MAX_RETRIES=3

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=globex_products

# ===== Reranker（空 = 保留召回排序，rerank_applied=false） =====
# CJ 仅 Agent 混合检索使用精排；目录直接搜索和商品 ID/SKU 查询不调用。
# RERANKER_BASE_URL=https://your-reranker-host
# RERANKER_MODEL=qwen3-reranker-8b
# 独立服务商必须使用其 API Key；不配则兼容原有 LLM 网关密钥。
# 百炼 qwen3-rerank 可填完整 /compatible-api/v1/reranks 地址。
# 若与 embedding 同属百炼且密钥权限覆盖精排，可复用：
# RERANKER_API_KEY=${EMBEDDING_API_KEY}

# fixture 与 CJ 共用此开关。CJ 设为 1 时使用 BM25 + 向量 + RRF，再按配置调用 reranker。
# CJ 首次启动会为本地快照中的商品调用 embedding 网关建索引；后续启动按文本指纹复用。
HYBRID_RECALL_ENABLED=0

# ===== 上下文预算（token 单位） =====
CONTEXT_SIZE=128000
TOOL_RESULT_LIMIT=20000
# 完整摘要计量的上下文专项通过；回滚改回 legacy 并重启 API/worker。
CONTEXT_STRATEGY=layered
# 开发集选定 pressure：成功读取后且出现压力时裁剪，保护完整近期轮次。
CONTEXT_PRUNING_TIMING=pressure
CONTEXT_PRODUCT_TOKENS=6000
CONTEXT_TARGET_TOKENS=48000
TOKEN_BUDGET_TOTAL=0
# 非零启用调用前保守预留、实际usage结算；不足时规则回复不再调模型。

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic%20<base64-public-key-colon-secret-key>,x-langfuse-ingestion-version=4
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5
# OTEL_SERVICE_NAME=globex-agent
# 无显式 OTLP 端点时，以下三项自动启用 Langfuse Basic Auth 与 v4 摄取。
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-你的项目公钥
# LANGFUSE_SECRET_KEY=sk-lf-你的项目私钥
# Langfuse 配置与脱敏边界见 docs/Langfuse与端到端Trace.md；真实密钥仅注入本地环境。
# 默认演示身份是客户端声明，不是登录；持久 session owner 绑定默认开启。
IDENTITY_MODE=demo
SESSION_OWNER_BINDING=1
# 仅隔离成对评测固定已导入版本；常规运行留空，按发布记录和买家分组。
PROMPT_PIN_VERSION=
# 全进程运维指标只给明确的签名主体；空值关闭，启用还须 IDENTITY_MODE=hmac。
METRICS_READER_BUYERS=
# 严格模式设 IDENTITY_MODE=hmac；密钥至少 32 字节，只保存在服务端环境。
# IDENTITY_HMAC_SECRET=

# 长期记忆默认使用 LLM 提炼 + 当前 EMBEDDING_* 建立持久向量；保存失败不回退原文。
# 权威库为 DATA_DIR/buyer_memory.db，每位买家最多 200 条。
# 正向语义召回数量；dislike 硬约束全量保留。
PREFERENCE_TOP_K=5
# 旧 PREFERENCE_RELEVANCE_ENABLED 仅影响旧 PreferenceSelector，新记忆默认语义召回。
